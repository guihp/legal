# Copie para .env.local e preencha a anon key (Dashboard → Settings → API)
# Projeto Supabase: imobiliaria (ref bfcssdogttmqeujgmxdf)
VITE_SUPABASE_URL=https://bfcssdogttmqeujgmxdf.supabase.co
VITE_SUPABASE_ANON_KEY=

# Web Push (PWA) — public key only on the client (Fase 5 UI).
# Generate classic pair: npx web-push generate-vapid-keys
# Mirror the same public key as Edge secret VAPID_PUBLIC_KEY.
# Edge also needs: VAPID_PRIVATE_KEY, VAPID_SUBJECT (mailto:ops@example.com)
# Optional Edge: PUSH_DISPATCH_SECRET (header x-push-secret from pg_net vault)
VITE_VAPID_PUBLIC_KEY=
