# Vite/React SPA fallback for Hostinger (Apache)
ErrorDocument 404 /index.html

# MIME types for PWA assets
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/javascript .js
  AddType text/javascript .js
</IfModule>

# Service worker / workbox must not be cached aggressively
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|workbox-[a-zA-Z0-9_-]+\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never rewrite PWA entrypoints to index.html (explicit, even if file missing)
  RewriteRule ^sw\.js$ - [L]
  RewriteRule ^workbox-[a-zA-Z0-9_-]+\.js$ - [L]
  RewriteRule ^manifest\.webmanifest$ - [L]
  RewriteRule ^registerSW\.js$ - [L]

  # Serve existing files directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback all other routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Basic caching for static assets in /assets (adjust paths if needed)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
